{
  "base_url": {
    "description": "API base URL",
    "hint": "Include /v1.",
    "type": "string",
    "default": "https://api.openai.com/v1"
  },
  "api_key": {
    "description": "API key",
    "type": "string",
    "secret": true,
    "default": ""
  },
  "model": {
    "description": "Image model",
    "type": "string",
    "default": "gpt-image-2.6-flare"
  },
  "max_concurrent": {
    "description": "Concurrent jobs",
    "hint": "1 runs jobs in order.",
    "type": "int",
    "default": 1
  },
  "max_pending": {
    "description": "Waiting jobs",
    "hint": "0 rejects new jobs when busy.",
    "type": "int",
    "default": 3
  }
}
