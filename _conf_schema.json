{
  "base_url": {
    "description": "Images API base URL including /v1",
    "type": "string",
    "default": "https://api.openai.com/v1"
  },
  "api_key": {
    "description": "API key for the configured endpoint",
    "type": "string",
    "secret": true,
    "default": ""
  },
  "model": {
    "description": "Image model",
    "type": "string",
    "default": "gpt-image-2.6-flare"
  },
  "max_concurrent": {
    "description": "Maximum simultaneous image jobs (at least 1)",
    "type": "int",
    "default": 1
  },
  "max_pending": {
    "description": "Maximum waiting jobs (0 rejects new jobs while all workers are busy)",
    "type": "int",
    "default": 3
  }
}
